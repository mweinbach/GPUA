    { "crate": "video-tiles",       "upstream": "rune", "path": "examples/video-tiles",     "target": null, "decision": "deferred", "note": "Standalone Rune example app; port into RuneExamples once Rune and RuneKit core land." },
    { "crate": "web-hello",         "upstream": "rune", "path": "examples/web-hello",       "target": null, "decision": "deferred", "note": "Standalone Rune example app; port into RuneExamples once Rune and RuneKit core land." }
  ],
  "swift_only_targets": [
    { "target": "GPUIAndroid", "guard": "os(Android)", "note": "No upstream crate. Mirrors the shape of gpui_linux/gpui_ios (platform, dispatcher, display, window, events, keyboard, text_system) on top of the NDK + GPUIWGPU." },
    { "target": "CWebGPU", "note": "C interop packaging for standard WebGPU headers (wgpu-native v24.0.0.2)." },
    { "target": "CLinuxSys", "guard": "os(Linux)", "note": "C interop packaging for Linux system libraries (Wayland, X11, xkbcommon, FreeType, HarfBuzz, Fontconfig)." },
    { "target": "CWinSys", "guard": "os(Windows)", "note": "C bridge umbrella header and C++ COM implementation for Windows system libraries (D3D11, DXGI, D3DCompiler, DirectWrite, Win32)." },
    { "target": "CAndroidSys", "guard": "os(Android)", "note": "C interop bridge for Android NDK system libraries (JNI, ANativeWindow, ALooper, AChoreographer, AInputEvent, AFontMatcher, log) per ADR-0012." },
    { "target": "CWebSys", "guard": "os(WASI)", "note": "Zero-dependency C Wasm-import bridge for browser DOM, canvas, input, timers, clipboard, and fetch on WASI per ADR-0013." }
  ],
  "asset_extensions": [".metal", ".wgsl", ".hlsl", ".svg", ".png", ".gif"]
}
