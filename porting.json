    { "crate": "drop-files",        "upstream": "rune", "path": "examples/drop-files",      "target": null, "decision": "deferred", "note": "Standalone Rune example app; port into RuneExamples once Rune and RuneKit core land." },
    { "crate": "frosted-bar",       "upstream": "rune", "path": "examples/frosted-bar",     "target": null, "decision": "deferred", "note": "Standalone Rune example app; port into RuneExamples once Rune and RuneKit core land." },
    { "crate": "glass-card",        "upstream": "rune", "path": "examples/glass-card",      "target": null, "decision": "deferred", "note": "Standalone Rune example app; port into RuneExamples once Rune and RuneKit core land." },
    { "crate": "glass-panel",       "upstream": "rune", "path": "examples/glass-panel",     "target": null, "decision": "deferred", "note": "Standalone Rune example app; port into RuneExamples once Rune and RuneKit core land." },
    { "crate": "hello",             "upstream": "rune", "path": "examples/hello",           "target": null, "decision": "deferred", "note": "Standalone Rune example app; port into RuneExamples once Rune and RuneKit core land." },
    { "crate": "kit-gallery",       "upstream": "rune", "path": "examples/kit-gallery",     "target": null, "decision": "deferred", "note": "Standalone Rune example app; port into RuneExamples once Rune and RuneKit core land." },
    { "crate": "knobs",             "upstream": "rune", "path": "examples/knobs",           "target": null, "decision": "deferred", "note": "Standalone Rune example app; port into RuneExamples once Rune and RuneKit core land." },
    { "crate": "lab",               "upstream": "rune", "path": "examples/lab",             "target": null, "decision": "deferred", "note": "Standalone Rune example app; port into RuneExamples once Rune and RuneKit core land." },
